@model Demo.Models.Libro
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3"><div class="col-md-8"><label asp-for="Titulo" class="form-label"></label><input asp-for="Titulo" class="form-control" placeholder="Ej. Rayuela"/><span asp-validation-for="Titulo" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Ejemplares" class="form-label"></label><input asp-for="Ejemplares" class="form-control" min="0"/><span asp-validation-for="Ejemplares" class="text-danger"></span></div><div class="col-md-6"><label asp-for="ISBN" class="form-label"></label><input asp-for="ISBN" class="form-control" placeholder="978..."/><span asp-validation-for="ISBN" class="text-danger"></span></div><div class="col-md-6"><label asp-for="AutorId" class="form-label"></label><select asp-for="AutorId" asp-items="ViewBag.Autores" class="form-select"><option value="">Selecciona un autor</option></select><span asp-validation-for="AutorId" class="text-danger"></span></div></div>
