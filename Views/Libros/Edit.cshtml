@model Demo.Models.Libro
@{ ViewData["Title"] = "Editar libro"; }
<div class="form-page"><a class="back-link" asp-action="Index">← Volver al catálogo</a><div class="form-card"><span class="eyebrow">CATÁLOGO</span><h1>Editar libro</h1><p>Actualiza la información de <strong>@Model.Titulo</strong>.</p><form asp-action="Edit" method="post"><input asp-for="LibroId" type="hidden"/><partial name="_Form" model="Model"/><div class="form-actions"><a asp-action="Index" class="btn btn-soft">Cancelar</a><button class="btn btn-primary" type="submit">Guardar cambios</button></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
