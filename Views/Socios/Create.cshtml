@model Demo.Models.Socio
@{ ViewData["Title"] = "Nuevo socio"; }
<div class="form-page"><a class="back-link" asp-action="Index">← Volver a socios</a><div class="form-card"><span class="eyebrow">COMUNIDAD</span><h1>Registrar un socio</h1><p>Los datos permitirán identificar a quien solicita cada préstamo.</p><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-6"><label asp-for="DNI" class="form-label"></label><input asp-for="DNI" class="form-control" inputmode="numeric" placeholder="8 dígitos"/><span asp-validation-for="DNI" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" placeholder="Nombres y apellidos"/><span asp-validation-for="Nombre" class="text-danger"></span></div><div class="col-12"><label asp-for="Email" class="form-label">Correo electrónico <span class="optional">(opcional)</span></label><input asp-for="Email" class="form-control" placeholder="nombre@correo.com"/><span asp-validation-for="Email" class="text-danger"></span></div></div><div class="form-actions"><a asp-action="Index" class="btn btn-soft">Cancelar</a><button class="btn btn-primary" type="submit">Guardar socio</button></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
